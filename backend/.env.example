# 平台使用费 AI 辅助催收系统 — 后端环境变量示例
# 复制为 backend/.env 并按需修改（pydantic-settings 读运行目录的 .env）

# 数据库（开发期 SQLite，生产/集成用 PostgreSQL）
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://collection:collection_dev_pwd@localhost:5432/collection

# JWT
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM（talk-002 实现，OpenAI 兼容协议，不绑死供应商）
# .env 的值为默认兜底；主管可在前端「配置后台」运行时修改（存 DB）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AI_TALK_ENABLED=false

# 应用
APP_NAME=平台使用费催收系统
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]
